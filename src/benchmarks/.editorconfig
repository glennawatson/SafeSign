[*.cs]

###################
# Code Analysis (CA) - Disable rules for benchmark projects
###################
dotnet_diagnostic.CA1001.severity = none # Owns disposable fields (cleaned up in [GlobalCleanup])
dotnet_diagnostic.CA1063.severity = none # Implement IDisposable correctly
dotnet_diagnostic.CA1065.severity = none # Do not raise exceptions in unexpected locations
dotnet_diagnostic.CA1707.severity = none # Identifiers should not contain underscores
dotnet_diagnostic.CA1812.severity = none # Avoid uninstantiated internal classes
dotnet_diagnostic.CA1822.severity = none # Benchmark methods must be instance methods
dotnet_diagnostic.CA2213.severity = none # Disposable fields are disposed in [GlobalCleanup]

###################
# PerformanceSharp / StyleSharp benchmark relaxations
###################
dotnet_diagnostic.SST1432.severity = none # Benchmark fixtures need not be static
dotnet_diagnostic.SST2334.severity = none # Benchmark types are not inspected in a watch window
dotnet_diagnostic.SST2410.severity = none # Benchmark process owns fixtures and cleans up in [GlobalCleanup]
dotnet_diagnostic.PSH1410.severity = none # Do not force AggressiveInlining on [Benchmark] entry points
performancesharp.avoid_linq_on_hot_path = false
dotnet_diagnostic.PSH1100.severity = none # Benchmarks harness can use LINQ for reporting
dotnet_diagnostic.PSH1101.severity = error # Simplify LINQ Where plus terminal calls
dotnet_diagnostic.PSH1102.severity = error # Simplify LINQ type filters
