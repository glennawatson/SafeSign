{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    "group:dotnetMonorepo",
    "group:nugetMonorepo",
    "security:openssf-scorecard"
  ],
  "mode": "full",
  "timezone": "Australia/Melbourne",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 10,
  "labels": ["dependencies"],
  "recreateWhen": "auto",
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "commitMessageAction": "bump",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "labels": ["dependencies", "security"]
  },
  "packageRules": [
    {
      "description": "TUnit and the testing-platform extensions move together; a mismatch breaks the run rather than a test.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^TUnit(\\.|$)/", "/^Microsoft\\.Testing\\./"],
      "groupName": "test runner"
    },
    {
      "description": "Refit packages move in lockstep.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^Refit(\\.|$)/"],
      "groupName": "Refit"
    },
    {
      "description": "Build analyzers are grouped together and labelled build-gate since warnings are treated as errors.",
      "matchManagers": ["nuget"],
      "matchPackageNames": [
        "StyleSharp.Analyzers",
        "PerformanceSharp.Analyzers",
        "SecuritySharp.Analyzers",
        "PublicApiSharp.Analyzers"
      ],
      "groupName": "build analyzers",
      "labels": ["dependencies", "build-gate"]
    },
    {
      "description": "MinVer decides the shipped version.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["/^MinVer$/"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The current stable BenchmarkDotNet cannot run .NET 11 benchmarks; track previews until stable support ships.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["BenchmarkDotNet"],
      "ignoreUnstable": false
    },
    {
      "description": "The SDK band is updated deliberately via the dependency dashboard.",
      "matchManagers": ["nuget"],
      "matchDepTypes": ["dotnet-sdk", "msbuild-sdk"],
      "dependencyDashboardApproval": true,
      "ignoreUnstable": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Keep shared actions pinned to a commit while tracking main through the ref comment.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["glennawatson/actions-common"],
      "pinDigests": true,
      "groupName": "shared GitHub Actions"
    },
    {
      "description": "Pinning names the group it pins rather than the generic dependencies topic.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["pin", "pinDigest"],
      "group": {
        "commitMessageTopic": "GitHub Actions digests"
      }
    },
    {
      "description": "Minor, patch and digest updates to actions from GitHub and Microsoft merge automatically.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["/^actions\\//", "/^github\\//", "/^microsoft\\//"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Digest updates to Microsoft's, Docker's Dockerfile syntax and ReactiveUI's container images merge automatically.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^mcr\\.microsoft\\.com\\//", "/^ghcr\\.io\\/reactiveui\\//", "docker/dockerfile"],
      "matchUpdateTypes": ["digest", "pin", "pinDigest"],
      "automerge": true
    }
  ]
}
